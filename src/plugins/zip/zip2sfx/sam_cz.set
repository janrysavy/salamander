;Self-Extractor Options

;This is a sample file with options for the Self-Extractor. All
;values listed here are the default values for the individual variables.
;
;File syntax:
;
;Lines beginning with a semicolon are treated as comments and are
;ignored while the file is processed.
;
;All variables except the variable version are optional. If a
;variable is not found in the options file, its default value is used.
;Default values for language-dependent variables (dlg_text,
;dlg_title, button_text) are read from the SFX package in use.
;
;All values represented by a string, including empty strings, must
;be enclosed in double quotation marks. To write quotation marks inside
;a string, use two double quotation marks in succession.
;
;Numeric values must not be enclosed in quotation marks.


;configuration file version, the current version is 2
;this is the only required variable

version=2

;specifies the target directory; it may be an absolute path
;or a relative path; a relative path is resolved against the current
;directory when the self-extracting archive is started
;you can also use predefined variables at the beginning (!) of the
;'target_dir' string:
;
;  $(Temp)      temporary directory; must not be followed by any additional
;               text in target_dir
;  $(ProgFiles) user's "Program Files" directory
;  $(WinDir)    Windows directory
;  $(SysDir)    system directory
;  $[variable]  value of the environment variable named 'variable'
;  $<regkey>    value of the registry entry named 'regkey', e.g.
;               SOFTWARE\Microsoft\Windows\CurrentVersion\ProgramFilesDir

target_dir=""

;determines whether the user is allowed to change the target directory
;for extracting the archive
;set this value to 1 if you want to allow the change

allow_dir_change=1

;determines whether the files in the temporary directory are deleted
;when the program specified by the 'command' variable ends
;set this value to 1 if you want to delete the files in the temporary
;directory
;this option makes sense only when 'target_dir' is set to "$(Temp)";
;in other cases the value is ignored

remove_temp=0

;this option allows waiting before deleting files in the temporary
;directory for a different program than the one specified by 'command'
;after this program finishes, the self-extractor deletes the files in the
;temporary directory and exits as well
;this option is necessary only if the installer starts a program that
;continues with the installation while the original installer terminates
;this is how, for example, some versions of InstallShield behave
;this option is ignored unless 'remove_temp' is set to 1

wait_for=""

;determines whether extraction starts automatically after the
;self-extracting archive is launched
;set this value to 1 if you want extraction to start automatically

autostart=0

;determines whether to display a dialog box reporting the result of
;extracting the archive
;set this value to 1 if you want to display this dialog

show_summary=1

;determines whether to display the program dialog box
;set this value to 1 if you want to display this dialog
;this option only makes sense when 'autostart' is set to 1; otherwise
;the value is ignored

hide_dlg=0

;determines whether to overwrite files in the target directory
;automatically
;set this value to 1 if you want files to be overwritten automatically

ovewrite_all=0

;determines whether to create the target directory automatically
;without prompting the user
;set this value to 1 if you want the target directory to be created
;automatically

create_target_dir=0

;program, HTTP link, or document that should be run/opened after the
;archive is successfully extracted; the path is relative to the target
;directory where the archive is extracted; you can also provide command
;line parameters for the program

command=""

;sfx package that should be used to create the self-extracting archive;
;the relative path is resolved against the directory containing zip2sfx.exe

sfxpackage="..\sfx\czech.sfx"

;buttons used in the optional dialog box
;may be one of: "ok", "ok_cancel", "yes_no", "agree_disagree"

mbox_buttons="ok"

;type of the optional dialog box
;may be one of: "simple", "exclamation", "information",
;"question", "long_message"

mbox_type="simple"

;text and title of the optional dialog box shown before extracting the
;archive begins
;if you do not want any dialog to appear, leave both variables empty ("")

mbox_text=""
mbox_title=""

;text displayed in the main dialog box

dlg_text="Tento program rozbal ZIP archiv."

;title of the main dialog box

dlg_title="Samorozbaliteln ZIP archiv"

;text of the 'extract' button in the main dialog box

button_text="&Rozbalit"

;company name shown in the lower left corner of the dialog box

vendor="Self-Extractor  2000-2023 Open Salamander Authors"

;web link shown in the lower right corner of the dialog box

link="https://www.altap.cz"

;file containing the icon; it can be either an ICO file or a PE executable
;module (such as a Win32 EXE or DLL) that contains an icon
;the relative path is resolved against the directory containing zip2sfx.exe

icon_file="..\zip.spl"

;positive value means the index of the icon (its ordinal number) in the
;executable specified by 'icon_file'
;negative value means the resource ID of the icon
;for ICO files the index is always 0 and the value of the variable is ignored

icon_index=-500

;request administrator privileges on Windows Vista or later

requires_administrative_privileges=1
